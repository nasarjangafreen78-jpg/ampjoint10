    "httpsen-us-ampjoint-10.site.html": {
      "settings": {
        "main": true,
        "title": "AMP Joint-10™ Official Website | Premium Joint Health Support| USA",
        "meta_descr": "Looking for AMP Joint-10™ in the USA? Explore the official website to discover what's inside the advanced formula, how it supports joint mobility, and why it's gaining attention.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "meta_image": "@PROJECT_PATH@/assets/images/ampjoint101784313728907-300x300.png"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
              ".navbar-dropdown": {
                "position": "relative !important"
              },
              "& when (@transparent)": {
                ".navbar-dropdown": {
                  "position": "absolute !important"
                }
              }
            },
            "& when (@sticky)": {
